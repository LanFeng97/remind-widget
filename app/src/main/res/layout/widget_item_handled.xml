<?xml version="1.0" encoding="utf-8"?>
<!--
  已处理的事件行（沉在所属栏目列表最下面，灰色）：
    · 完成：✓ 13:00 维生素D  13:40 ↺   （名称划删除线）
    · 忽略：⊘ 19:00 钙片     13:40 ↺   （不划删除线）

  右侧内容区只有约 155dp，五列必须压到最紧：
    mark 14dp + 提醒时刻 32dp + 名称(flex) + 处理时刻 26dp + 撤销 24dp
  名称因此只剩约 59dp（4 个汉字），超长会省略号截断，这是 4×2 的硬约束。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ih_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/ih_mark"
        android:layout_width="14dp"
        android:layout_height="wrap_content"
        android:textSize="10.5sp"
        android:textColor="@color/w_text_weak"
        android:includeFontPadding="false"
        android:text="✓" />

    <TextView
        android:id="@+id/ih_time"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:textSize="9.5sp"
        android:textColor="@color/w_text_weak"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="13:00" />

    <TextView
        android:id="@+id/ih_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="12sp"
        android:textColor="@color/w_text_weak"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="维生素D" />

    <!-- 被完成 / 被忽略的时刻 -->
    <TextView
        android:id="@+id/ih_done"
        android:layout_width="26dp"
        android:layout_height="wrap_content"
        android:textSize="9sp"
        android:textColor="@color/w_text_weak"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:gravity="end"
        android:text="13:40" />

    <!-- 撤销：点它把这一条退回待办，不用回 App -->
    <TextView
        android:id="@+id/ih_undo"
        android:layout_width="24dp"
        android:layout_height="26dp"
        android:layout_marginStart="2dp"
        android:gravity="center"
        android:textSize="12sp"
        android:textColor="@color/w_text_weak"
        android:includeFontPadding="false"
        android:text="↺" />
</LinearLayout>
