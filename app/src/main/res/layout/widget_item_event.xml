<?xml version="1.0" encoding="utf-8"?>
<!-- 小组件里的一行事件：13:00 维生素D 每天 ○ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ie_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="2.5dp"
    android:paddingBottom="2.5dp">

    <TextView
        android:id="@+id/ie_time"
        android:layout_width="34dp"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/w_text_sub"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="13:00" />

    <TextView
        android:id="@+id/ie_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="12.5sp"
        android:textColor="@color/w_text"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="维生素D" />

    <TextView
        android:id="@+id/ie_rule"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="9.5sp"
        android:textColor="@color/w_text_weak"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:layout_marginStart="4dp"
        android:text="每天" />

    <TextView
        android:id="@+id/ie_dot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textSize="12sp"
        android:textColor="@color/w_dot_empty"
        android:includeFontPadding="false"
        android:text="○" />
</LinearLayout>
