<?xml version="1.0" encoding="utf-8"?>
<!--
  4x2 小组件声明。

  尺寸踩过的坑，记在这里避免以后再试错：
   · Google 系的 Launcher 按老公式算格数：格数 ≈ (minWidth + 30) / 70，所以 4x2 = 250x110dp。
     给到 160dp 高，Pixel 会排成 4x3（多出一格空白），不是我们要的 4x2。
   · Android 12+ 的 targetCellWidth/targetCellHeight 才是精确格数声明，HyperOS / ColorOS 优先读它。
     两套值一起给：老 ROM 走 dp 公式，新 ROM 走 targetCell。
   · v1.0 在小米上"小部件列表里找不到"，最可能的原因是缺 previewImage ——
     部分 ROM 只展示带预览图的三方组件。现在补上了。
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_main"
    android:previewLayout="@layout/widget_main"
    android:previewImage="@drawable/widget_preview"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description" />
