<?xml version="1.0" encoding="utf-8"?>
<!--
  4x2 小组件声明。

  尺寸这块踩过坑：v1.0 用的是老标准 minWidth=250dp / minHeight=110dp（按 70dp 一格算），
  小米 HyperOS 的格子更大，判定下来不足 2 格高，组件就被藏进了"不适用"分类里，
  用户在小部件列表里根本找不到。

  现在按更宽的规格给：
    · minWidth=320dp / minHeight=160dp —— 覆盖 Pixel、HyperOS、ColorOS 的常见格子尺寸
    · targetCellWidth/Height=4/2 —— API 31+ 的精确格数声明，HyperOS 会优先用它
    · previewImage —— 部分 ROM 只展示带预览图的三方组件
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="320dp"
    android:minHeight="160dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_main"
    android:previewLayout="@layout/widget_main"
    android:previewImage="@drawable/widget_preview"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description" />
